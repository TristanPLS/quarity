# =============================================================================
# Quarity — variables d'environnement
# Copier en .env  ( cp .env.example .env )  et renseigner les valeurs.
# ⚠ NE JAMAIS committer .env (déjà ignoré par .gitignore). Aucun secret réel ici.
# =============================================================================

# --- PostgreSQL (OLTP métier) ---
POSTGRES_USER=quarity
POSTGRES_PASSWORD=change_me_pg
POSTGRES_DB=quarity
POSTGRES_PORT=5432

# --- ClickHouse (analytics mesures) ---
CLICKHOUSE_USER=quarity
CLICKHOUSE_PASSWORD=change_me_ch
CLICKHOUSE_DB=quarity
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- Redis (cache L2 + pub/sub) ---
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# --- OpenAQ (source de données — clé gratuite : https://openaq.org/) ---
OPENAQ_API_KEY=
# Réglages ingestion (optionnels, défauts sains — cf. back/src/bin/ingest.rs) :
# OPENAQ_LOCATION_ID=4085   OPENAQ_DAYS=7   OPENAQ_ORG_SLUG=agglo-riviera   OPENAQ_MAX_PAGES=50

# --- Back Rust/Axum (auth JWT + mesures) ---
# JWT_SECRET : OBLIGATOIRE, >= 32 caractères, vraie valeur aléatoire. Le back REFUSE de démarrer
# avec ce placeholder (détection au boot). Générer une vraie valeur : openssl rand -hex 32
JWT_SECRET=change_me_jwt_secret_at_least_32_chars_long
JWT_ACCESS_TTL_SECONDS=900
BACK_PORT=8080
RUST_LOG=info,sqlx=warn
# CORS : origines front autorisées, séparées par des virgules (défaut dev : http://localhost:3000).
# En prod derrière nginx (same-origin) peut rester vide ; ex. prod : https://app.quarity.example
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Refresh tokens & rate-limit (cf. back/src/config.rs — défauts sains si absentes)
REFRESH_TTL_SECS=604800
RATE_LIMIT_LOGIN_EMAIL_PER_MIN=5
RATE_LIMIT_LOGIN_IP_PER_MIN=20
RATE_LIMIT_REFRESH_IP_PER_MIN=30
# Le back construit ses URLs (DATABASE_URL/REDIS_URL/CLICKHOUSE_URL) à partir des variables
# ci-dessus via docker-compose.yml (connexion par nom de service postgres/clickhouse/redis).

# --- Front React/Vite (nginx, proxy /api -> back) ---
FRONT_PORT=3000

# --- Front (Jalon 2) [décommenter quand le service front sera activé] ---
# FRONT_PORT=3000
# VITE_API_BASE_URL=http://localhost:8080
